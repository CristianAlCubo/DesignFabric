{
  "name": "@designfabric/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio Electron de DesignFabric (tabpane unificado de ClearCut + DesignFabric).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_SKIP_BINARY_DOWNLOAD electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE -u ELECTRON_SKIP_BINARY_DOWNLOAD electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:linux": "env -u ELECTRON_RUN_AS_NODE electron-builder --linux AppImage --x64 --config electron-builder.yml",
    "dist:win": "env -u ELECTRON_RUN_AS_NODE electron-builder --win portable --x64 --config electron-builder.yml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.60.0",
    "lucide-react": "^1.25.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "36.9.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
